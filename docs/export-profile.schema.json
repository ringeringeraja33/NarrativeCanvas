{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/narrative-canvas/export-profile.schema.json",
  "title": "Narrative Canvas Export Profile",
  "type": "object",
  "required": ["format", "version", "exportedAt", "source", "baseSlug", "files", "targets", "mappings", "warnings"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "narrative-canvas-export-profile"
    },
    "version": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": ["title", "notes"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "baseSlug": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "mappings": {
      "$ref": "#/$defs/mappings"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["id", "name", "role", "format"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["id", "label", "fileId", "consumer"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "fileId": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "mappings": {
      "type": "object",
      "required": ["variables", "nodes"],
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "linkId": {
          "type": "string"
        },
        "choiceId": {
          "type": "string"
        }
      }
    }
  }
}

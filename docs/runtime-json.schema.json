{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative-canvas.dev/schemas/runtime-json-v1.schema.json",
  "title": "Narrative Canvas Runtime JSON v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "exportedAt",
    "source",
    "startNodeId",
    "startNode",
    "variables",
    "variableNames",
    "characters",
    "nodes",
    "links",
    "playbook",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "narrative-canvas-runtime"
    },
    "version": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": ["title", "notes", "richTextFormat"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "richTextFormat": {
          "enum": ["markdown", "html", "unity", "bbcode", "unreal"]
        }
      }
    },
    "startNodeId": { "type": "string" },
    "startNode": { "type": "string" },
    "variables": {
      "type": "object",
      "additionalProperties": true
    },
    "variableNames": {
      "type": "array",
      "items": { "type": "string" }
    },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" }
    },
    "codex": {
      "type": "array",
      "items": { "$ref": "#/$defs/codexEntry" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "playbook": {
      "type": "object",
      "required": ["rules", "actions"],
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "object",
          "additionalProperties": true
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/playbookAction" }
        }
      }
    },
    "report": {
      "type": "object",
      "required": ["warnings", "variableNameMap", "nodeNameMap"],
      "additionalProperties": false,
      "properties": {
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "variableNameMap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "nodeNameMap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "required": ["id", "name", "role", "voice", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "voice": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "codexEntry": {
      "type": "object",
      "required": ["id", "name", "kind", "role", "voice", "tags", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["Character", "Location", "Item", "Lore"] },
        "role": { "type": "string" },
        "voice": { "type": "string" },
        "tags": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "type",
        "typeLabel",
        "body",
        "requirements",
        "effects",
        "choices",
        "timer",
        "next",
        "routing",
        "cast",
        "customFields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "typeLabel": { "type": "string" },
        "body": { "type": "string" },
        "requirements": { "type": "string" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "timer": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/choiceTimer" }
          ]
        },
        "next": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        },
        "routing": { "$ref": "#/$defs/routing" },
        "cast": {
          "type": "array",
          "items": { "$ref": "#/$defs/castEntry" }
        },
        "customFields": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "effect": {
      "anyOf": [
        { "$ref": "#/$defs/stateEffect" },
        { "$ref": "#/$defs/conditionalEffect" }
      ]
    },
    "stateEffect": {
      "type": "object",
      "required": ["trigger", "op", "sourceKey", "key", "value", "valueSource", "valueMode"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "type": "string" },
        "op": { "type": "string" },
        "sourceKey": { "type": "string" },
        "key": { "type": "string" },
        "value": true,
        "valueSource": { "type": "string" },
        "valueMode": { "enum": ["literal", "variable"] }
      }
    },
    "conditionalEffect": {
      "type": "object",
      "required": ["trigger", "op", "condition", "thenEffect", "elseEffect"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "type": "string" },
        "op": { "const": "ifElse" },
        "condition": { "type": "string" },
        "thenEffect": { "$ref": "#/$defs/effect" },
        "elseEffect": { "$ref": "#/$defs/effect" }
      }
    },
    "choiceTimer": {
      "type": "object",
      "required": ["seconds", "fallbackLinkId", "fallbackChoiceOptionId", "targetId", "target"],
      "additionalProperties": false,
      "properties": {
        "seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "fallbackLinkId": { "type": "string" },
        "fallbackChoiceOptionId": { "type": "string" },
        "targetId": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "label", "condition", "effects", "targetId", "target", "linkId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "condition": { "type": "string" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "targetId": { "type": "string" },
        "target": { "type": "string" },
        "linkId": { "type": "string" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["targetId", "target", "condition", "source"],
      "additionalProperties": true,
      "properties": {
        "targetId": { "type": "string" },
        "target": { "type": "string" },
        "linkId": { "type": "string" },
        "condition": { "type": "string" },
        "source": { "enum": ["routing", "link"] }
      }
    },
    "routing": {
      "type": "object",
      "required": ["mode", "target", "targetId"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["continue", "end", "goTo"] },
        "target": { "type": "string" },
        "targetId": { "type": "string" }
      }
    },
    "castEntry": {
      "type": "object",
      "required": ["characterId", "name", "role"],
      "additionalProperties": false,
      "properties": {
        "codexId": { "type": "string" },
        "characterId": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["Character", "Location", "Item", "Lore"] },
        "role": { "type": "string" }
      }
    },
    "link": {
      "type": "object",
      "required": ["id", "fromId", "from", "toId", "to", "label", "choiceIndex", "choiceOptionId", "condition"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "fromId": { "type": "string" },
        "from": { "type": "string" },
        "toId": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "choiceIndex": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "choiceOptionId": { "type": "string" },
        "condition": { "type": "string" }
      }
    },
    "playbookAction": {
      "type": "object",
      "required": ["id", "trigger", "op", "target", "category", "key", "stateKey", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "trigger": { "type": "string" },
        "op": { "type": "string" },
        "target": { "type": "string" },
        "category": { "type": "string" },
        "key": { "type": "string" },
        "stateKey": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "nodeId": { "type": "string" },
        "linkId": { "type": "string" },
        "choiceId": { "type": "string" }
      }
    }
  }
}
